# This is a comment.

fn stringModuleTest()
{
	import string;

	var sample = "Hello, world!";
	var reversed = string.reverse(sample);
	var trimmable = "Hello,    world!";
	var trimmed = string.trim(trimmable);
	var upper = string.upper(sample);
	var lower = string.lower(sample);
	var repeated = string.repeat(sample, 5);

	println("sample =", sample);
	println("reversed =", reversed);
	println("trimmable =", trimmable);
	println("trimmed =", trimmed);
	println("upper =", upper);
	println("lower =", lower);
	println("repeated =", repeated);

	if string.contains(sample, "Hello")
	{
		println("Sample string contains 'Hello'");
	}

	if string.startsWith(sample, "H")
	{
		println("Sample string starts with 'H'");
	}

	if string.endsWith(sample, "!")
	{
		println("Sample string ends with '!'");
	}

	var arr = [10, 20, 40, 80];
	var joined = string.join(arr, " -> ");
	println("joined =", joined);

	var split = string.split(joined, " -> ");
	println("split =", split);
}

fn mathModuleTest()
{
	import math;

	println("pi =", math.PI);
	println("e =", math.E);
	println("tau =", math.TAU);
	println("infinity =", math.INF);
	println("negative infinity =", math.NEGINF);
	println("NaN =", math.NAN);

	var sampleNumber = 50;
	var sampleNegativeNumber = -sampleNumber;

	var squareRoot = math.sqrt(sampleNumber);
	var absolute = math.abs(sampleNegativeNumber);

	var decimalNum = 15.5;
	var floored = math.floor(decimalNum);
	var ceilinged = math.ceil(decimalNum);
	var rounded = math.round(decimalNum);

	var power = math.pow(sampleNumber, 2);

	println("The square root of", sampleNumber, "is", squareRoot);
	println("The absolute value of", sampleNegativeNumber, "is", absolute);

	println(decimalNum, "rounded down is", floored);
	println(decimalNum, "rounded up is", ceilinged);
	println(decimalNum, "rounded is", rounded);

	println(sampleNumber, "to the power of two is", power);

	var max = math.max(50, 20);
	var min = math.min(10, 20);
	var clamped = math.clamp(50, 0, 100);

	println("The maximum of 50 and 20 is", max);
	println("The minimum of 10 and 20 is", min);
	println("50 clamped to 0 and 100 is", clamped);
}

fn log(source, message)
{
	println("[" + source + "]", message);
}

fn variableTest()
{
	var a = 10;
	println(a);
}

fn mathTest()
{
	var a = 10;
	var b = 20;

	var c = a + b; # addition
	var d = a - b; # subtraction
	var e = a * b; # multiplication
	var f = a / b; # division
	var g = a % b; # modulo

	println("a =", a);
	println("b =", b);
	println("c =", c);
	println("d =", d);
	println("e =", e);
	println("f =", f);
	println("g =", g);
}

fn ifTest(condition)
{
	if condition
	{
		println("Provided condition is true");
	}
	else
	{
		println("Provided condition is false");
	}
}

fn whileTest()
{
	var i = 0;

	while i < 10
	{
		println("i =", i);
		i = i + 1;
	}
}

fn arrayTest()
{
	var arr = [1, 2, 3, 4, 5, 6];

	println("Array length:", arr.length);
	println(arr);
	
	log("Arrays", "Pushing new element");
	arr.push(7);

	println("Array length after push:", arr.length);
	println(arr);

	log("Arrays", "Popping last element");
	var last = arr.pop();

	println("Array length after pop:", arr.length);
	println("Last element:", last);
}

fn stringTest()
{
	var str = "Hello, world!";
	var strLen = str.length;

	println("str =", str);
	println("strLen =", strLen);

	var strConcat = str + " String concatenation!";
	var newLen = strConcat.length;

	println("strConcat =", strConcat);
	println("newLen =", newLen);
}

fn conversionTest()
{
	var validNumStr = "100";
	var invalidNumStr = "Invalid";

	println("validNumStr =", validNumStr);
	println("invalidNumStr =", invalidNumStr);

	var validNum = toNumber(validNumStr);
	println("validNum =", validNum);

	# var invalidNum = toNumber(invalidNumStr); # ERROR!
	# println("invalidNum =", invalidNum);

	println("true (stringified) =", toString(true));
	println("1 (stringified) =", toString(1));
	println("[1, 2] (stringified) =", toString([1, 2]));
}

log("Variables", "Testing variable definition");
variableTest();

log("Math", "Testing math operations");
mathTest();

log("If", "Testing if statement (true)");
ifTest(true);

log("If", "Testing if statement (false)");
ifTest(false);

log("While", "Testing while statement");
whileTest();

log("Arrays", "Testing arrays");
arrayTest();

log("Strings", "Testing strings");
stringTest();

log("Conversion", "Testing number-to-string and string-to-number conversion");
conversionTest();

log("Modules", "Testing math module");
mathModuleTest();

log("Modules", "Testing string module");
stringModuleTest();

log("Tests", "Finished!");